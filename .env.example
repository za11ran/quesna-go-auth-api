# ---- انسخ هذا الملف باسم .env ثم عدّل القيم ----

# منفذ السيرفر المحلي
PORT=4000

# بيئة التشغيل: development أثناء التجربة، production عند النشر
# في development يرجع السيرفر كود الـ OTP داخل الرد (dev_otp) عشان تجرب بدون SMS
NODE_ENV=development

# رابط الاتصال بقاعدة بيانات PostgreSQL
# محلي:   postgresql://postgres:PASSWORD@localhost:5432/quesnago
# Neon/Supabase: انسخ الـ Connection String من لوحة التحكم (يحتوي على ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quesnago

# سر توقيع رمز الدخول (JWT) - غيّره لأي نص عشوائي طويل (32 حرف أو أكثر)
JWT_SECRET=ضع_هنا_نص_عشوائي_طويل_جدا_وغيّره
JWT_EXPIRES_IN=30d

# إعدادات كود التحقق OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# كود OTP ثابت مؤقت للتجربة اليدوية قبل الاشتراك في مزوّد SMS.
# لو متضبّط: أي حساب يقبل هذا الكود في verify-otp، ويرجع في الرد كـ dev_otp.
# ⚠️ احذف السطر ده تمامًا بعد ربط الـ SMS.
DEV_LOGIN_OTP=123456

# مجلد الصور المرفوعة (نسبيًا لجذر المشروع أو مسار مطلق)
UPLOADS_DIR=./uploads

# مهلة رفض عرض التوصيل للدليفري (ثواني)
DELIVERY_OFFER_TIMEOUT_SEC=60

# ---- إيميل الأدمن لإشعارات Change Requests (Resend) ----
# لو فاضي: الإشعار يتسجّل في اللوحة والإيميل best-effort
RESEND_API_KEY=
MAIL_FROM=Quesna Go <onboarding@resend.dev>
ADMIN_EMAIL=m.s.za11ran@gmail.com
