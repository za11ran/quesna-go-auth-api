# ---- انسخ هذا الملف باسم .env ثم عدّل القيم ----

# منفذ السيرفر المحلي
PORT=4000

# بيئة التشغيل: development أثناء التجربة، production عند النشر
# في development يرجع السيرفر كود الـ OTP داخل الرد (dev_otp) عشان تجرب بدون SMS
NODE_ENV=development

# رابط الاتصال بقاعدة بيانات PostgreSQL
# محلي:   postgresql://postgres:PASSWORD@localhost:5432/delivery
# Neon/Supabase: انسخ الـ Connection String من لوحة التحكم (يحتوي على ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery

# سر توقيع رمز الدخول (JWT) - غيّره لأي نص عشوائي طويل (32 حرف أو أكثر)
JWT_SECRET=ضع_هنا_نص_عشوائي_طويل_جدا_وغيّره
JWT_EXPIRES_IN=30d

# إعدادات كود التحقق OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
